# Signal-Main Backend Environment Variables
# Copy this file to .env and fill in the values.
# DO NOT commit .env to version control.

# --- App ---
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

